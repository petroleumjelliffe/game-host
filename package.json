{
  "name": "game-host",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*",
    "apps/*"
  ],
  "scripts": {
    "start:host": "tsx apps/host/main.ts",
    "start:host:compiled": "node --enable-source-maps apps/host/dist/main.mjs",
    "dev:host": "tsx --env-file-if-exists=.env watch apps/host/main.ts",
    "test": "node scripts/test-all.mjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run typecheck && npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
