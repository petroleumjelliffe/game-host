{
  "name": "acquire-startups-m1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "predev:server": "node scripts/check-port.mjs 4002",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "prebuild": "tsx scripts/generate-manifest.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "verify:layout": "node scripts/verify-layout.mjs",
    "build:server": "test -f vendor/lobby/protocol/protocol.ts || { echo 'ERROR: vendor/lobby is empty. The server imports it at runtime, and tsx compiles nothing at build time — so without this check the build goes green and the process dies at boot with ERR_MODULE_NOT_FOUND. Clone with --recurse-submodules, or run: git submodule update --init --recursive'; exit 1; }",
    "start:server": "tsx server/index.ts",
    "serve": "npm run build && tsx server/index.ts",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "check:bundle": "vite build && ! grep -rlE \"['\\\"]vitest['\\\"]\" dist/assets 2>/dev/null && ! grep -rlE 'baseline turn cycle|turn order draw, starting tiles' dist/assets 2>/dev/null",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.14"
  }
}
