{
  "name": "@game-host/railbaron",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./*.js": "./*.ts",
    "./*": "./*.ts"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "serve": "npm run build && tsx server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "graph:validate": "node scripts/validate-graph.mjs",
    "graph:names": "node scripts/propose-city-names.mjs",
    "network:build": "node scripts/build-network.mjs --write",
    "outline:build": "node scripts/build-outline.mjs --write"
  },
  "dependencies": {
    "@game-host/host": "*",
    "@game-host/lobby": "*",
    "@game-host/room-store": "*",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "us-atlas": "^3.0.1"
  }
}
