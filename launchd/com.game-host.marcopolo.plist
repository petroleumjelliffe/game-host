<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Paths go through the /opt/homebrew/etc/game-host symlink (created in
	     README setup) so no username or clone location is baked in — the same
	     trick the Caddyfile's menu root uses. -->
	<key>Label</key>
	<string>com.game-host.marcopolo</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/opt/homebrew/etc/game-host/start-marcopolo.sh</string>
	</array>
	<!-- launchd gives agents a bare PATH. node comes first from the repo's
	     node-bin symlink (created in README setup, pointing at fnm's default
	     alias) — NOT /usr/local/bin, where a leftover x86_64 node once broke
	     every native binding (esbuild, rollup) under Rosetta, 2026-08-17. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/etc/game-host/node-bin:/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart on crash, not on clean exit — so `launchctl bootout` (and a
	     deliberate stop) stays stopped, but a wedged process comes back. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/game-host.marcopolo.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/game-host.marcopolo.log</string>
</dict>
</plist>
