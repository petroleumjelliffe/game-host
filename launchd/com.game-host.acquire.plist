<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Paths go through the /opt/homebrew/etc/game-host symlink (created in
	     README setup) so no username or clone location is baked in — the same
	     trick the Caddyfile's menu root uses. -->
	<key>Label</key>
	<string>com.game-host.acquire</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/opt/homebrew/etc/game-host/start-acquire.sh</string>
	</array>
	<!-- launchd gives agents a bare PATH; npm and node live in homebrew. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart on crash, not on clean exit — so `launchctl bootout` (and a
	     deliberate stop) stays stopped, but a wedged process comes back. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/game-host.acquire.log</string>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/game-host.acquire.log</string>
</dict>
</plist>
