# The game machine's front door: path routing on port 80.
#
#   caddy run --config Caddyfile          # foreground, for trying it
#   brew services start caddy             # as a service; caddy reads
#                                         # /opt/homebrew/etc/Caddyfile, so
#                                         # symlink this file there:
#                                         #   ln -sf ~/Developer/game-host/Caddyfile \
#                                         #          /opt/homebrew/etc/Caddyfile
#
# Port numbers come from PORTS.md, next to this file — the registry lives in
# this repo because this file is its enforcing consumer. Each game's client
# is built (and dev-served) under its path prefix — Rail Baron's basePath.ts
# says '/railbaron' — so nothing strips the prefix: `handle` + `reverse_proxy`
# pass the path through untouched, and Vite/the router expect exactly that.
#
# Sockets deliberately do NOT go through this proxy. Each game's client
# derives its server address as <page hostname>:<server port>, so socket
# traffic goes straight to the 400N port on the LAN. Routing it here instead
# would need the socket.io `path` option plumbed through the shared lobby's
# connection — not worth it while the ports are reachable anyway.

# Any name this machine answers to on the LAN. `.local` covers the mDNS name
# through renames; add a real domain here if subdomain routing ever lands.
http:// {
	# --- Rail Baron: one process on 4001 serves pages, assets and sockets --
	# (start-railbaron.sh builds the client and starts the server.)
	# For hot reload behind the proxy instead, point this at 7931 and run
	# `npm run dev:all` in the game repo.
	handle /railbaron/* {
		reverse_proxy localhost:4001
	}
	handle /railbaron {
		# The bare `*` matcher is required: redir's first argument is a
		# path matcher when it starts with `/`, so `redir /railbaron/`
		# alone parses as a matcher with no destination.
		redir * /railbaron/
	}

	# --- Acquire: uncomment when its client serves under /acquire ----------
	# handle /acquire/* {
	# 	reverse_proxy localhost:7932
	# }
	# handle /acquire {
	# 	redir * /acquire/
	# }

	# --- Marco Polo: uncomment when it exists ------------------------------
	# handle /marcopolo/* {
	# 	reverse_proxy localhost:7933
	# }

	# --- The menu: everything else is the flat game list -------------------
	# `root` needs an absolute path when caddy runs as a service, which
	# couples this file to where the repo is cloned — see README.md.
	# {env.HOME} resolves at runtime, so no username is baked in here.
	handle {
		root * {env.HOME}/Developer/game-host/menu
		file_server
	}
}
