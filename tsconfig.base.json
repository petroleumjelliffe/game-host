{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@game-host/lobby/*.js": ["./packages/lobby/*.ts"],
      "@game-host/lobby/*": ["./packages/lobby/*.ts"]
    }
  }
}
