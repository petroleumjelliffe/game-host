{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["protocol", "server", "vendor/lobby/protocol", "vendor/lobby/server"]
}
